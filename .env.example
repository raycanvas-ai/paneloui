# Optional. Powers the live agent demo (/api/agent). Without it the rest of the site works.
# Free from Groq (console.groq.com/keys), no card. The demo is public, so it can hit the
# free tier's daily limit; suggestions keep working when it does, since they never call the model.
GROQ_API_KEY=

# Checkout for Pro (/checkout). A Dodo Payments API key, and the mode it belongs to.
# Anything but live_mode uses test mode.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Accounts and Pro licences (/account, /r/pro). Postgres, then: npx drizzle-kit migrate
DATABASE_URL=
# Any long random string: openssl rand -base64 32
AUTH_SECRET=
# OAuth apps, callback URL: <site>/api/auth/callback/github and /google
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Signing secret of this site's webhook endpoint (<site>/api/webhooks/dodo) in the Dodo dashboard.
# The test and live webhook signing secrets, comma-separated.
DODO_WEBHOOK_SECRET=

# Public origin for redirects and Dodo's return URL, e.g. https://www.paneloui.com. Unset locally.
SITE_URL=
