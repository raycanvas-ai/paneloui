# www is canonical; the bare domain only redirects.
www.paneloui.com {
	encode zstd gzip
	reverse_proxy app:3000 {
		# The app rate-limits by client IP. There's no Cloudflare in front, so a client-sent
		# Cf-Connecting-Ip is a forgery: drop it. Caddy sets X-Forwarded-For itself.
		header_up -Cf-Connecting-Ip
	}
}

paneloui.com {
	redir https://www.paneloui.com{uri} permanent
}

# Live template demos. Until templates launch they redirect to /templates (nothing about them is public);
# on launch day, swap each `redir` for its `reverse_proxy` line. Kept out of search either way.
demo-admin.paneloui.com {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	redir https://www.paneloui.com/templates
	# reverse_proxy demo-admin:3000
}

demo-propflow.paneloui.com {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	redir https://www.paneloui.com/templates
	# reverse_proxy demo-propflow:3000
}
